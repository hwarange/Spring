<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        [4단계] Spring Legacy Web 설정

        우리가 직접 만든 것 vs Spring Legacy:
        - DispatcherServlet 클래스: com.ssafy.mvc.DispatcherServlet → org.springframework.web.servlet.DispatcherServlet
        - 설정 파일: Java init() 코드 → servlet-context.xml (XML 분리)
        - 공통 빈 초기화: 없음 → ContextLoaderListener + servlet-root.xml
        - 인코딩 처리: 없음 → CharacterEncodingFilter 제공
        - URL 패턴: /* → / (정적 리소스 제외)
    -->

    <!-- ① Root Application Context 설정 파일 지정 (Service, DAO 등 공통 빈) -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>/WEB-INF/spring/servlet-root.xml</param-value>
    </context-param>

    <!-- ② Root Application Context 생성 리스너 (서버 시작 시 실행) -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- ③ 인코딩 필터 (모든 요청을 UTF-8로 처리) -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ④ Spring DispatcherServlet 등록 -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <!-- 우리가 init()에서 Java 코드로 했던 것을 이제 XML 파일에서 관리 -->
            <param-name>contextConfigLocation</param-name>
            <param-value>/WEB-INF/spring/servlet-context.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <!-- /* 대신 / 사용: 정적 리소스(css, js, 이미지)는 Tomcat Default Servlet에게 위임 -->
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>
